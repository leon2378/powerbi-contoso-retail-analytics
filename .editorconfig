root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# TMDL is indentation-sensitive and uses tabs.
[*.tmdl]
indent_style = tab
indent_size = 4

[*.{yml,yaml,json,pbir,pbism,pbip}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
