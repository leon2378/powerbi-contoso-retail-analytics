* text=auto

# Power BI Desktop writes CRLF; keep it stable across OSes so diffs stay clean.
*.tmdl  text eol=crlf
*.pbism text eol=crlf
*.pbir  text eol=crlf
*.pbip  text eol=crlf
powerbi/**/*.json text eol=crlf

*.ps1 text eol=crlf
*.sh  text eol=lf
*.py  text eol=lf
*.sql text eol=lf
*.yml text eol=lf

*.parquet binary
*.7z      binary
