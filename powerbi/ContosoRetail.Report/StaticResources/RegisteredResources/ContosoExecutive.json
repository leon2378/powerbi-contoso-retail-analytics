{
  "name": "Contoso Executive",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#4A3AA7",
    "#E34948"
  ],
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#8A8984",
  "background": "#FFFFFF",
  "backgroundLight": "#F0EFEC",
  "backgroundNeutral": "#E6E5E1",
  "tableAccent": "#2A78D6",
  "hyperlink": "#256ABF",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#104281",
  "center": "#F0EFEC",
  "minimum": "#CDE2FB",
  "null": "#8A8984",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "title": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "header": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#0B0B0B"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#52514E"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": { "solid": { "color": "#FFFFFF" } },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": { "solid": { "color": "#E6E5E1" } },
            "radius": 8
          }
        ],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 12, "bottom": 12, "left": 16, "right": 16 }],
        "title": [
          {
            "show": true,
            "fontSize": 12,
            "fontColor": { "solid": { "color": "#0B0B0B" } }
          }
        ],
        "valueAxis": [
          {
            "gridlineColor": { "solid": { "color": "#E6E5E1" } },
            "gridlineThickness": 1,
            "showAxisTitle": false
          }
        ],
        "categoryAxis": [{ "showAxisTitle": false, "gridlineShow": false }]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": { "solid": { "color": "#F5F5F3" } },
            "transparency": 0
          }
        ],
        "outspace": [{ "color": { "solid": { "color": "#F5F5F3" } } }]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [{ "strokeWidth": 2 }],
        "legend": [{ "show": true, "position": "Top" }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "show": false }],
        "border": [{ "show": false }]
      }
    }
  }
}
