                            "value": {
                              "Literal": {
                                "Value": "0D"
                              }
                            }
                          },
                          "max": {
                            "color": {
                              "Literal": {
                                "Value": "'#86B6EF'"
                              }
                            },
                            "value": {
                              "Literal": {
                                "Value": "0.3D"
                              }
                            }
                          },
                          "nullColoringStrategy": {
                            "strategy": {
                              "Literal": {
                                "Value": "'noColor'"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "data": [
              {
                "dataViewWildcard": {
                  "matchingOption": 1
                }
              }
            ],
            "metadata": "_Measures.Sales vs Budget %"
