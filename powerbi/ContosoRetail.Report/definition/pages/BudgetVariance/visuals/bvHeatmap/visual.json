            "bottom": {
              "expr": {
                "Literal": {
                  "Value": "4D"
                }
              }
            },
            "left": {
              "expr": {
                "Literal": {
                  "Value": "16D"
                }
              }
            },
            "right": {
              "expr": {
                "Literal": {
                  "Value": "16D"
                }
              }
            }
          }
        }
