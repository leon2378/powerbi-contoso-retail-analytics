                        "Measure": {
                          "Expression": {
                            "SourceRef": {
                              "Entity": "_Measures"
                            }
                          },
                          "Property": "Sales vs Budget %"
                        }
                      },
                      "FillRule": {
                        "linearGradient3": {
                          "min": {
                            "color": {
                              "Literal": {
                                "Value": "'#F2ADAD'"
