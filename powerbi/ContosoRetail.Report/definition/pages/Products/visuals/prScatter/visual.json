{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.3.0/schema.json",
  "name": "prScatter",
  "position": {
    "x": 16,
    "y": 180,
    "z": 8000,
    "height": 236,
    "width": 1248,
    "tabOrder": 8000
  },
  "visual": {
    "visualType": "scatterChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Product"
                    }
                  },
                  "Property": "Subcategory"
                }
              },
              "queryRef": "Product.Subcategory",
              "nativeQueryRef": "Subcategory",
              "active": true
            }
          ]
        },
        "X": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Sales Amount"
                }
              },
              "queryRef": "_Measures.Sales Amount",
              "nativeQueryRef": "Sales Amount"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Margin %"
                }
              },
              "queryRef": "_Measures.Margin %",
              "nativeQueryRef": "Margin %"
            }
          ]
        },
        "Tooltips": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Margin"
                }
              },
              "queryRef": "_Measures.Margin",
              "nativeQueryRef": "Margin"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Quantity"
                }
              },
              "queryRef": "_Measures.Quantity",
              "nativeQueryRef": "Quantity"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Products Sold"
                }
              },
              "queryRef": "_Measures.Products Sold",
              "nativeQueryRef": "Products Sold"
            }
          ]
        }
      }
    },
    "objects": {
      "categoryAxis": [
        {
          "properties": {
            "logAxisScale": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            }
          }
        }
      ],
      "categoryLabels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "8D"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#52514E'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2A78D6'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Sales vs margin % by subcategory (sales on a log scale)'"
                }
              }
            }
          }
        }
      ],
      "padding": [
        {
          "properties": {
            "top": {
              "expr": {
                "Literal": {
                  "Value": "8D"
                }
              }
            },
            "bottom": {
              "expr": {
                "Literal": {
                  "Value": "4D"
                }
              }
            },
            "left": {
              "expr": {
                "Literal": {
                  "Value": "16D"
                }
              }
            },
            "right": {
              "expr": {
                "Literal": {
                  "Value": "16D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
