model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parameters

	annotation PBI_QueryGroupOrder = 0

queryGroup Functions

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataRoot","SqlEndpoint","LakehouseName","RangeStart","RangeEnd","fnLoadTable","Sales","Budget","Date","Customer","Product","Store","Security Access","_Measures"]

ref table _Measures
ref table Sales
ref table Budget
ref table Date
ref table Customer
ref table Product
ref table Store
ref table 'Security Access'
ref table 'Time Intelligence'
ref table 'Metric Selector'

ref role 'Global Viewer'
ref role 'Regional Manager'

