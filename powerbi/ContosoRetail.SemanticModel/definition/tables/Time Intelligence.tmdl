/// Time-intelligence variants for any measure: put 'Time Calculation' on columns or in a slicer.
/// Prior-year items only compare dates that have sales ('Date'[Date With Sales]), so a partial
/// current year is compared like-for-like with the same span of the previous year.
table 'Time Intelligence'
	lineageTag: 9292aef3-f500-40ac-816d-1c80f2b9285b

	calculationGroup
		precedence: 10

		calculationItem Current = SELECTEDMEASURE ()

		calculationItem MTD = CALCULATE ( SELECTEDMEASURE (), DATESMTD ( 'Date'[Date] ) )

		calculationItem QTD = CALCULATE ( SELECTEDMEASURE (), DATESQTD ( 'Date'[Date] ) )

		calculationItem YTD = CALCULATE ( SELECTEDMEASURE (), DATESYTD ( 'Date'[Date] ) )

		calculationItem PY =
				CALCULATE (
				    SELECTEDMEASURE (),
				    CALCULATETABLE ( DATEADD ( 'Date'[Date], -1, YEAR ), 'Date'[Date With Sales] = TRUE )
				)

		calculationItem 'PY YTD' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    DATESYTD (
				        CALCULATETABLE ( DATEADD ( 'Date'[Date], -1, YEAR ), 'Date'[Date With Sales] = TRUE )
				    )
				)

		calculationItem YoY =
				VAR _Current = SELECTEDMEASURE ()
				VAR _PreviousYear =
				    CALCULATE (
				        SELECTEDMEASURE (),
				        CALCULATETABLE ( DATEADD ( 'Date'[Date], -1, YEAR ), 'Date'[Date With Sales] = TRUE )
				    )
				RETURN
				    // Text measures (labels, dynamic titles) pass through unchanged.
				    IF (
				        NOT ISNUMBER ( _Current ),
				        _Current,
				        IF ( NOT ISBLANK ( _PreviousYear ), _Current - _PreviousYear )
				    )

		calculationItem 'YoY %' =
				VAR _Current = SELECTEDMEASURE ()
				VAR _PreviousYear =
				    CALCULATE (
				        SELECTEDMEASURE (),
				        CALCULATETABLE ( DATEADD ( 'Date'[Date], -1, YEAR ), 'Date'[Date With Sales] = TRUE )
				    )
				// Relative change of a ratio is misleading; use YoY (percentage points) for these.
				// Listed explicitly: inside this item SELECTEDMEASUREFORMATSTRING() already returns
				// this item's own "%" format, so it cannot detect ratio measures.
				VAR _IsRatioMeasure =
				    ISSELECTEDMEASURE (
				        [Margin %], [Discount %], [Sales vs Budget %], [Repeat Customer %], [Cohort Retention %],
				        [Sales Mix %], [Online Sales %]
				    )
				RETURN
				    // Text measures (labels, dynamic titles) pass through unchanged; a blank current value stays blank.
				    IF (
				        NOT ISNUMBER ( _Current ),
				        _Current,
				        IF ( NOT _IsRatioMeasure, DIVIDE ( _Current - _PreviousYear, _PreviousYear ) )
				    )

			formatStringDefinition = "+0.0%;-0.0%;0.0%"

		calculationItem 'Rolling 12M' =
				CALCULATE (
				    SELECTEDMEASURE (),
				    DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -12, MONTH )
				)

	column 'Time Calculation'
		dataType: string
		lineageTag: d5d45afd-f4dc-4904-923b-fd178eb2a4ae
		summarizeBy: none
		sourceColumn: Name
		sortByColumn: Ordinal

	column Ordinal
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 463c8020-5926-40f1-a1f5-9d24951ff0ad
		summarizeBy: none
		sourceColumn: Ordinal

	partition 'Time Intelligence' = calculationGroup

