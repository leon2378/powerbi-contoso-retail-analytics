/// Home table for all report measures. Combine them with the 'Time Intelligence'
/// calculation group for MTD/QTD/YTD, prior-year and year-over-year variants.
table _Measures
	lineageTag: 3edab853-7136-4273-9033-e0edc08e1565

	/// Net sales after discounts, in USD. The headline revenue KPI.
	measure 'Sales Amount' = SUM ( Sales[Net Amount] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 9cf39d22-edad-46f0-9eda-af4a2ebba784

	/// Sales at list price before discounts, in USD.
	measure 'Gross Sales' = SUM ( Sales[Gross Amount] )
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: a268dacd-9667-4563-bf38-360ae7782d3d

	/// Value given away as discounts: Gross Sales minus Sales Amount.
	measure 'Discount Amount' = [Gross Sales] - [Sales Amount]
		formatString: \$#,0
		displayFolder: Sales
		lineageTag: 472b6408-03e5-44a1-b6d2-302f5d4b30cb

	/// Share of gross sales given away as discounts.
	measure 'Discount %' = DIVIDE ( [Discount Amount], [Gross Sales] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 508edeac-9a55-4b9a-80b6-b5b34221464d

	/// Units sold.
	measure Quantity = SUM ( Sales[Quantity] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 368dac72-c885-4c2f-b6af-9246dbd181bb

	/// Average net price per unit sold.
	measure 'Avg Selling Price' = DIVIDE ( [Sales Amount], [Quantity] )
		formatString: \$#,0.00
		displayFolder: Sales
		lineageTag: 5cffc3e4-34e1-4fe9-90b1-e6766d89caf8

	/// Net sales in the order currency. Returns BLANK unless exactly one currency is in context,
	/// because amounts in different currencies cannot be added up.
	measure 'Sales Amount (Local Currency)' =
			IF (
			    HASONEVALUE ( Sales[Currency Code] ),
			    SUM ( Sales[Net Amount (Local)] )
			)
		displayFolder: Sales
		lineageTag: c29a2179-5765-4b0d-923e-8880e26f0898

		formatStringDefinition =
				VAR _Currency = SELECTEDVALUE ( Sales[Currency Code], "" )
				RETURN
				    """" & _Currency & """ #,0"

	/// Product cost of the units sold, in USD.
	measure 'Total Cost' = SUM ( Sales[Cost Amount] )
		formatString: \$#,0
		displayFolder: Margin
		lineageTag: 6310fe4d-aa1e-4339-81e0-3cfde02d9a1f

	/// Sales Amount minus Total Cost.
	measure Margin = [Sales Amount] - [Total Cost]
		formatString: \$#,0
		displayFolder: Margin
		lineageTag: 974a9c2c-8e2e-4699-a495-fcb4677d7324

	/// Margin as a share of Sales Amount.
	measure 'Margin %' = DIVIDE ( [Margin], [Sales Amount] )
		formatString: 0.0%
		displayFolder: Margin
		lineageTag: 1f083133-a34c-4bb4-af55-049a28b895ba

	/// Number of distinct orders.
	measure Orders = DISTINCTCOUNT ( Sales[Order Number] )
		formatString: #,0
		displayFolder: Orders & Customers
		lineageTag: 2bbd2bab-4aad-49e4-9a6d-8c2a404a40a6

	/// Number of order lines.
	measure 'Order Lines' = COUNTROWS ( Sales )
		formatString: #,0
		displayFolder: Orders & Customers
		lineageTag: 1ca6e3cc-c54d-421d-93ac-554416fbc101

	/// Average net sales per order.
	measure 'Avg Order Value' = DIVIDE ( [Sales Amount], [Orders] )
		formatString: \$#,0.00
		displayFolder: Orders & Customers
		lineageTag: 1d8d6125-34ea-488c-9dae-c73b901f423d

	/// Distinct customers who bought in the selected period.
	measure Customers = DISTINCTCOUNT ( Sales[Customer Key] )
		formatString: #,0
		displayFolder: Orders & Customers
		lineageTag: 2110a75d-6b5e-4db1-bfe9-a6f1ba77b601

	/// Customers whose first-ever order falls inside the selected period.
	measure 'New Customers' =
			CALCULATE (
			    [Customers],
			    TREATAS ( VALUES ( 'Date'[Date] ), Customer[First Order Date] )
			)
		formatString: #,0
		displayFolder: Orders & Customers
		lineageTag: ebeb7fe4-fc58-4e60-8761-549eca5281a8

	/// Customers who bought in the period and had also bought before it.
	measure 'Returning Customers' = [Customers] - [New Customers]
		formatString: #,0
		displayFolder: Orders & Customers
		lineageTag: 44d9f1ae-e641-4179-aad7-4e1e1f25a55c

	/// Average net sales per buying customer.
	measure 'Sales per Customer' = DIVIDE ( [Sales Amount], [Customers] )
		formatString: \$#,0.00
		displayFolder: Orders & Customers
		lineageTag: 62cc77b7-356b-4aeb-9b06-c4052d89fec5

	/// Average days between order and delivery, per order line.
	measure 'Avg Delivery Days' = AVERAGE ( Sales[Delivery Days] )
		formatString: 0.0
		displayFolder: Delivery
		lineageTag: c5071548-7394-47e7-8030-bb70773c7868

	/// Sales Amount by delivery date instead of order date (activates the inactive relationship).
	measure 'Sales Amount by Delivery Date' =
			CALCULATE (
			    [Sales Amount],
			    USERELATIONSHIP ( Sales[Delivery Date], 'Date'[Date] )
			)
		formatString: \$#,0
		displayFolder: Delivery
		lineageTag: 6ce1e765-985b-466a-b12b-5f51cb006a7f

	/// Budget in USD. The budget exists at month x category x store-country grain, so this returns
	/// BLANK whenever the report filters below that grain (single days, subcategories, products,
	/// stores or any customer attribute) rather than showing a misleading total.
	measure 'Budget Amount' =
			VAR _IsDateAtBudgetGrain =
			    COUNTROWS ( 'Date' )
			        = CALCULATE ( COUNTROWS ( 'Date' ), ALL ( 'Date' ), VALUES ( 'Date'[Year Month Number] ) )
			VAR _IsProductAtBudgetGrain =
			    COUNTROWS ( 'Product' )
			        = CALCULATE ( COUNTROWS ( 'Product' ), ALL ( 'Product' ), VALUES ( 'Product'[Category Key] ) )
			VAR _IsStoreAtBudgetGrain =
			    COUNTROWS ( Store )
			        = CALCULATE ( COUNTROWS ( Store ), ALL ( Store ), VALUES ( Store[Country Code] ) )
			VAR _IsCustomerUnfiltered =
			    NOT ISCROSSFILTERED ( Customer )
			RETURN
			    IF (
			        _IsDateAtBudgetGrain && _IsProductAtBudgetGrain && _IsStoreAtBudgetGrain && _IsCustomerUnfiltered,
			        SUM ( Budget[Budget Amount] )
			    )
		formatString: \$#,0
		displayFolder: Budget
		lineageTag: 40dd5218-1e84-4fcc-ad28-276a11dd30a5

	/// Budget for months that have started (up to the last order date), so it can be compared with
	/// actuals. Future months' budget is excluded; use [Budget Amount] to show the full plan.
	measure 'Budget to Date' =
			SUMX (
			    FILTER (
			        VALUES ( 'Date'[Year Month Number] ),
			        CALCULATE ( COUNTROWS ( 'Date' ), 'Date'[Date With Sales] = TRUE ) > 0
			    ),
			    [Budget Amount]
			)
		formatString: \$#,0
		displayFolder: Budget

	/// Sales Amount for months that have a budget. The first year of history has no budget, so it is
	/// excluded from budget comparisons.
	measure 'Sales in Budget Months' =
			CALCULATE (
			    [Sales Amount],
			    FILTER ( VALUES ( 'Date'[Year Month Number] ), NOT ISBLANK ( [Budget Amount] ) )
			)
		formatString: \$#,0
		displayFolder: Budget

	/// Actuals minus budget over the same months: [Sales in Budget Months] - [Budget to Date].
	/// BLANK where no budget applies.
	measure 'Sales vs Budget' =
			VAR _Budget = [Budget to Date]
			RETURN
			    IF ( NOT ISBLANK ( _Budget ), [Sales in Budget Months] - _Budget )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Budget
		lineageTag: da3fcb4d-5d31-4c17-834c-3553730ae34a

	/// Variance to budget as a share of budget, comparing the same months on both sides.
	measure 'Sales vs Budget %' =
			VAR _Budget = [Budget to Date]
			RETURN
			    DIVIDE ( [Sales in Budget Months] - _Budget, _Budget )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Budget
		lineageTag: fd55b1c1-6f81-4701-b147-d2c80124dd49

	/// Report-header freshness label, e.g. "Data through 31 Dec 2025". Ignores all report filters.
	measure 'Data Freshness' =
			VAR _LastOrderDate =
			    CALCULATE ( MAX ( Sales[Order Date] ), REMOVEFILTERS () )
			RETURN
			    "Data through " & FORMAT ( _LastOrderDate, "d mmm yyyy" )
		displayFolder: Report Helpers
		lineageTag: acf75dc2-19e8-4b97-81b6-8da17842f47b

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["CR_MEASURE_FORMAT_STRING"]}

	column Placeholder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 04738417-4115-4fff-90cb-8a95b33afc03
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table(type table [Placeholder = Int64.Type], {})
				in
				    Source

	annotation PBI_ResultType = Table

